{
  "name": "recetas",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/generate-prisma-client.mjs && next dev",
    "build": "node scripts/generate-prisma-client.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "node scripts/generate-prisma-client.mjs",
    "db:postgres:check": "node scripts/postgres-schema-check.mjs",
    "test:import": "node --experimental-strip-types --loader ./scripts/alias-loader.mjs --test scripts/import-*.test.ts scripts/local-ocr.test.ts scripts/office-document-import.test.ts scripts/pdf-import.test.ts scripts/text-document-import.test.ts",
    "test:phase0": "./scripts/phase0-checks.sh",
    "test:phase1": "node --experimental-strip-types --loader ./scripts/alias-loader.mjs --test scripts/phase1-use-cases.test.ts",
    "test:phase2": "node --experimental-strip-types --loader ./scripts/alias-loader.mjs --test scripts/phase2-use-cases.test.ts scripts/recipe-family-link-sanitization.test.ts",
    "test:phase3": "node --experimental-strip-types --loader ./scripts/alias-loader.mjs --test scripts/phase3-ops.test.ts scripts/family-deletion-workflow.test.ts",
    "test:phase4": "node --experimental-strip-types --loader ./scripts/alias-loader.mjs --test scripts/phase4-health.test.ts scripts/page-recipe-list-loader.test.ts",
    "import:cleanup": "node --experimental-strip-types --loader ./scripts/alias-loader.mjs scripts/import-session-cleanup.ts",
    "test:auth": "node --experimental-strip-types --loader ./scripts/alias-loader.mjs --test scripts/auth-provider-config.test.ts scripts/auth-use-cases.test.ts scripts/auth-boundary-imports.test.ts scripts/clerk-auth-routes.test.ts scripts/clerk-user-linker.test.ts scripts/local-auth-provider.test.ts scripts/profile-completion.test.ts scripts/user-repository-contract.test.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.3.3",
    "@prisma/adapter-better-sqlite3": "^7.4.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.4.0",
    "@vercel/blob": "^2.3.3",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.4.1",
    "bun": "^1.3.9",
    "jsonwebtoken": "^9.0.2",
    "next": "16.1.6",
    "pnpm": "^10.30.0",
    "prisma": "^7.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "yarn": "^1.22.22"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "playwright": "^1.60.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  }
}
